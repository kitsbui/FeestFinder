{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "festfinder-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "scripts/preview.sh"
      ],
      "port": 3000
    },
    {
      "name": "festfinder-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "festfinder-backend"
      ],
      "port": 4000
    },
    {
      "name": "festfinder-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "festfinder-web"
      ],
      "port": 3000
    }
  ]
}
