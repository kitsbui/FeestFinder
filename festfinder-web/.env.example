# Copy to .env.local, or set in the Vercel project (Root Directory festfinder-web).

# Where the FeestFinder API runs. Read at build time (it becomes the proxy rewrite) and at runtime.
FF_API_ORIGIN=http://localhost:4000
# This site's own address: canonical links, the sitemap, structured data.
SITE_URL=http://localhost:3000
# The same value as the API's WEB_PROXY_SECRET (32+ characters), when the API is another
# deployment: each visitor keeps their own rate limit, and Google sign-in comes back here.
WEB_PROXY_SECRET=
# The map's PMTiles archives and glyphs, as on the API (their origins are allowed by the CSP).
MAP_TILES_URL=
MAP_OVERVIEW_URL=
MAP_GLYPHS_URL=
# Serve /kit, the page of every part (off in production).
FF_KIT=
