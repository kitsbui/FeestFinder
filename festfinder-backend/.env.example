# Copy to .env (or export in your shell). Everything but DATABASE_URL has a development default.

NODE_ENV=development
PORT=4000
# Development listens on localhost only; production on every interface.
HOST=
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated origins allowed to call the API with cookies (Web, Organizer, Admin apps).
CORS_ORIGINS=http://localhost:3000

# Database: one of two Supabase projects. Production is used by the production deployment
# only; staging by laptops (here) and Vercel previews. Required: the API does not start
# without it. Use the transaction pooler (Supabase → Connect → port 6543); its certificate
# is verified against Supabase's own root, which ships with the API. `npm run db:check`
# tests the URL and says which environment's database it is.
DATABASE_URL=
# Each database is labelled production or staging, and the API refuses to start on the
# other environment's. Production is the production deployment (or NODE_ENV=production);
# everything else is staging. FF_ENV=production|staging settles it, e.g. to run
# `npm run migrate` against production on purpose.
FF_ENV=
# Or the name of the variable that holds the URL, when an integration sets its own.
DATABASE_URL_FROM=
# The automated tests use an embedded PGlite database instead, named with PGLITE_DIR.
# Demo data exists only there (test/fixtures): nothing seeds it into Supabase.

# Admin accounts, comma-separated, made at startup for emails that have no account yet.
# They have no password: each owner sets one with "Forgot password" on /ops. An existing
# account is never promoted.
ADMIN_EMAIL=

# FF_NOW pins "now" for the demo data in the tests. It is ignored on Supabase, where it
# would stamp real rows with a made-up date.

# Required in production, which does not start without them; staging (previews included)
# falls back to development values. Make each with `openssl rand -base64 32`. The ticket
# secret signs every ticket's QR code: set it once and never change it.
TICKET_SIGNING_SECRET=
PAYMENT_WEBHOOK_SECRET=
COOKIE_SECURE=false

# vietqr = bank transfer QR + webhook. `mock` (instant, fake payment) for testing on staging;
# production refuses it: it would issue tickets nobody paid for.
PAYMENT_PROVIDER=vietqr
SERVICE_FEE_PCT=5
PLATFORM_BANK_BIN=970436
PLATFORM_BANK_ACCOUNT=0000000000
PLATFORM_BANK_ACCOUNT_NAME=CONG TY FESTFINDER

# Uploads go to Supabase Storage when S3_* below is set, otherwise into the database
# (table stored_files). UPLOAD_DIR is for the tests' embedded database only.

# AI local guide (Claude). Without credentials the endpoint returns 503 guide_unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_GUIDE_ENABLED=true

# Facebook / Instagram login. Without these that sign-in is unavailable (the tests' embedded database uses a stand-in).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Background jobs (outbox delivery, reminders, expiries). On by default outside Vercel: a
# laptop runs them on the staging database. On Vercel, pg_cron calls POST /internal/jobs every
# minute ("Authorization: Bearer <CRON_SECRET>"); only the production deployment points it
# there, and in production the secret defaults to a key derived from TICKET_SIGNING_SECRET.
JOBS_ENABLED=
LINK_CHECKS_ENABLED=true
CRON_SECRET=
# Return OTP codes in API responses as well as in the server log. Staging only: production
# refuses it, since a code in a response lets anyone into any account.
EXPOSE_DEV_CODES=true

# Requests per IP per minute on the API. Sign-in, OTP and door scanning have their own
# tighter limits; the screens' static chunks are not counted.
RATE_LIMIT_PER_MINUTE=300

# Object storage for uploaded images: Supabase Storage (S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3,
# bucket `uploads`, S3_PUBLIC_BASE_URL=https://<ref>.supabase.co/storage/v1/object/public/uploads)
# or any S3-compatible store. Without S3_BUCKET, images are kept in the database.
S3_BUCKET=
S3_REGION=auto
# Set for anything that is not AWS, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The public URL images are served from, e.g. https://cdn.feestfinder.com
S3_PUBLIC_BASE_URL=

# Email. Without SMTP_HOST, email is printed to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FeestFinder <no-reply@feestfinder.com>

# One endpoint that forwards push, Zalo and SMS to whichever provider you use. The API
# posts {id, channel, to, template, payload} signed with x-ff-signature (HMAC-SHA256).
MESSAGING_WEBHOOK_URL=
MESSAGING_WEBHOOK_SECRET=

# Unhandled errors go here. Empty = log only.
SENTRY_DSN=
RELEASE=dev

# Browser push (Web Push with VAPID). Generate a pair once with:
#   npx web-push generate-vapid-keys
# Browsers subscribe through the service worker and get notifications straight from
# their push service; without these, browser subscriptions go to the messaging webhook.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@feestfinder.com

# Proxies allowed to report the client's address in X-Forwarded-For (addresses, CIDRs,
# loopback/linklocal/uniquelocal, a hop count, or true/false). The default trusts this
# machine and private networks: the Next.js app and a load balancer in the same network.
TRUST_PROXY=loopback,linklocal,uniquelocal

# IndexNow key (8–128 letters, digits or dashes): approved and changed event pages are
# announced to Bing and the assistants that search its index. Served at /<key>.txt.
INDEXNOW_KEY=
# Let AI training crawlers (GPTBot, ClaudeBot, Google-Extended…) read the site. AI search and
# answer crawlers are always allowed; this only covers training. Default false.
ALLOW_AI_TRAINING=false
