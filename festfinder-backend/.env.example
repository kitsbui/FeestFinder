# Copy to .env (or export in your shell). Every value has a development default.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated origins allowed to call the API with cookies (Web, Organizer, Admin apps).
CORS_ORIGINS=http://localhost:3000

# Database. Leave DATABASE_URL empty to use embedded PGlite at PGLITE_DIR.
# Production: any Postgres 15+ (Supabase, Neon, RDS, Cloud SQL).
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# Pin "now" so the seeded festival weekend (18–20 Sep 2026) is "this weekend".
# Remove for real time.
FF_NOW=2026-09-14T10:00:00+07:00

# Required in production.
TICKET_SIGNING_SECRET=
PAYMENT_WEBHOOK_SECRET=
COOKIE_SECURE=false

# mock = instant confirmation (development only); vietqr = bank transfer QR + webhook.
PAYMENT_PROVIDER=mock
SERVICE_FEE_PCT=5
PLATFORM_BANK_BIN=970436
PLATFORM_BANK_ACCOUNT=0000000000
PLATFORM_BANK_ACCOUNT_NAME=CONG TY FESTFINDER

UPLOAD_DIR=./.data/uploads

# AI local guide (Claude). Without credentials the endpoint returns 503 guide_unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_GUIDE_ENABLED=true

# Facebook / Instagram login. Without these, development uses a mock provider and production disables them.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

JOBS_ENABLED=true
LINK_CHECKS_ENABLED=true
# Return OTP codes in API responses (never in production).
EXPOSE_DEV_CODES=true

# Requests per IP per minute on the API. Sign-in, OTP and door scanning have their own
# tighter limits; the screens' static chunks are not counted.
RATE_LIMIT_PER_MINUTE=300

# Object storage for uploaded images. Without S3_BUCKET, files stay in UPLOAD_DIR on
# local disk — fine for one machine, not for two. Works with S3, R2, B2 and MinIO.
S3_BUCKET=
S3_REGION=auto
# Set for anything that is not AWS, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The public URL images are served from, e.g. https://cdn.festfinder.vn
S3_PUBLIC_BASE_URL=

# Email. Without SMTP_HOST, email is printed to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FeestFinder <no-reply@festfinder.vn>

# One endpoint that forwards push, Zalo and SMS to whichever provider you use. The API
# posts {id, channel, to, template, payload} signed with x-ff-signature (HMAC-SHA256).
MESSAGING_WEBHOOK_URL=
MESSAGING_WEBHOOK_SECRET=

# Unhandled errors go here. Empty = log only.
SENTRY_DSN=
RELEASE=dev

# Browser push (Web Push with VAPID). Generate a pair once with:
#   npx web-push generate-vapid-keys
# Browsers subscribe through the service worker and get notifications straight from
# their push service; without these, browser subscriptions go to the messaging webhook.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@festfinder.vn

# Proxies allowed to report the client's address in X-Forwarded-For (addresses, CIDRs,
# loopback/linklocal/uniquelocal, a hop count, or true/false). The default trusts this
# machine and private networks: the Next.js app and a load balancer in the same network.
TRUST_PROXY=loopback,linklocal,uniquelocal
